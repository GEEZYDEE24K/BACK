# ==============================================================================
# PLATAFORMA DE TRUEQUE ESTUDIANTIL - VARIABLES DE ENTORNO (EJEMPLO)
# ==============================================================================

# Conexión a Base de Datos (PostgreSQL o SQLite)
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/trueque
DATABASEPROVIDER=Postgres

# Seguridad y Autenticación JWT
JWT_SECRET_KEY=MySuperSecretKey1234567890!@#$%^&*()_+
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookies Seguras (False para desarrollo HTTP localhost, True para producción HTTPS)
COOKIE_SECURE=False
COOKIE_HTTPONLY=True
COOKIE_SAMESITE=lax

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_SCOPES=openid email profile

# X (Twitter) OAuth 2.0
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:8000/auth/twitter/callback
TWITTER_SCOPES=tweet.read users.read offline.access
